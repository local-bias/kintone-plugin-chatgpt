{
  "name": "kintone-plugin-chatgpt",
  "version": "1.0.0",
  "author": "ribbit",
  "license": "MIT",
  "scripts": {
    "init": "plugin init && plugin genkey",
    "build:css-desktop": "pnpm dlx @tailwindcss/cli -i ./src/styles/desktop.css -o ./.plugin/contents/desktop.css --minify",
    "build:css-config": "pnpm dlx @tailwindcss/cli -i ./src/styles/config.css -o ./.plugin/contents/config.css --minify",
    "build:js": "plugin build",
    "build": "concurrently \"pnpm:build:*\" && plugin zip --ppk ./.plugin/oss.ppk",
    "standalone": "concurrently \"pnpm:build:*\" && plugin zip --env standalone --ppk ./.plugin/oss.ppk",
    "dev:js": "plugin dev --ppk C:/workspaces/apps/kintone-plugin/dev.ppk --cert-dir C:/workspaces/apps/cert",
    "dev:css-desktop": "pnpm dlx @tailwindcss/cli -i ./src/styles/desktop.css -o ./.plugin/dev/desktop.css --watch",
    "dev:css-config": "pnpm dlx @tailwindcss/cli -i ./src/styles/config.css -o ./.plugin/dev/config.css --watch",
    "dev": "concurrently \"pnpm:dev:*\""
  },
  "browser": {
    "path": false
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.67",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@heroicons/react": "^2.2.0",
    "@konomi-app/kintone-utilities": "^5.17.0",
    "@konomi-app/kintone-utilities-jotai": "^1.4.2",
    "@konomi-app/kintone-utilities-react": "^2.2.0",
    "@konomi-app/ui": "^2.3.0",
    "@konomi-app/ui-react": "^2.0.0",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "@radix-ui/react-slot": "^1.2.4",
    "@repo/constants": "workspace:*",
    "@repo/schema": "workspace:*",
    "ai": "^5.0.93",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "immer": "^10.2.0",
    "jotai": "^2.15.1",
    "jotai-derive": "^0.1.3",
    "jotai-effect": "^2.1.3",
    "jotai-optics": "^0.4.0",
    "lucide-react": "^0.553.0",
    "luxon": "^3.7.2",
    "marked": "^17.0.0",
    "nanoid": "^5.1.6",
    "notistack": "^3.0.2",
    "openai": "^6.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.0.0",
    "remeda": "^2.32.0",
    "tailwind-merge": "^3.4.0",
    "tiny-invariant": "^1.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@kintone/dts-gen": "^9.0.0",
    "@konomi-app/k2": "^1.12.2",
    "@types/luxon": "^3.7.1",
    "@types/marked": "^6.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "tailwindcss": "^4.1.17",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "zod": "^4.1.12"
  }
}
